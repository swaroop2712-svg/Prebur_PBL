# PreBurn Backend Environment Configuration

# PostgreSQL Connection String Format:
# postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/preburn_db

# For quick local testing without PostgreSQL installed, you can use SQLite:
# DATABASE_URL=sqlite:///./preburn.db

# API Settings
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5500","http://localhost:8000","*"]

# SMS Alert Provider Configuration
SMS_PROVIDER=demo
SMS_ENABLED=true
SMS_DEFAULT_OFFICER_PHONE=+919876543210
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FAST2SMS_API_KEY=
